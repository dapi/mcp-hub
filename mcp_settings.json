{
  "mcpServers": {
    "tavily": {
      "command": "npx",
      "args": [
        "-y",
        "tavily-mcp"
      ],
      "env": {
        "TAVILY_API_KEY": "${TAVILY_API_KEY}"
      },
      "autoload": true
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--headless",
        "--isolated"
      ],
      "enabled": false
    },
    "google_workspace": {
      "command": "uvx",
      "args": [
        "workspace-mcp",
        "--tools",
        "drive",
        "docs",
        "sheets"
      ],
      "env": {
        "GOOGLE_OAUTH_CLIENT_ID": "${GOOGLE_OAUTH_CLIENT_ID}",
        "GOOGLE_OAUTH_CLIENT_SECRET": "${GOOGLE_OAUTH_CLIENT_SECRET}",
        "PORT": "${GOOGLE_OAUTH_PORT}"
      }
    },
    "magic": {
      "command": "npx",
      "args": [
        "-y",
        "@21st-dev/magic@latest"
      ],
      "env": {
        "API_KEY": "${MAGIC_API_KEY}"
      },
      "enabled": false
    },
    "smartbear": {
      "command": "npx",
      "args": [
        "-y",
        "bugsnag-mcp-server"
      ],
      "env": {
        "BUGSNAG_API_KEY": "${BUGSNAG_API_KEY}"
      },
      "enabled": true
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ],
      "env": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      },
      "autoload": true
    },
    "docmost": {
      "command": "npx",
      "args": [
        "github:dapi/docmost-mcp"
      ],
      "env": {
        "DOCMOST_API_URL": "${DOCMOST_API_URL}",
        "DOCMOST_EMAIL": "${DOCMOST_EMAIL}",
        "DOCMOST_PASSWORD": "${DOCMOST_PASSWORD}"
      },
      "enabled": true
    },
    "krisp": {
      "type": "streamable-http",
      "url": "https://mcp.krisp.ai/mcp",
      "headers": {
        "Authorization": "Bearer ${KRISP_MCP_ACCESS_TOKEN}"
      },
      "oauth": {
        "clientId": "REDACTED_KRISP_CLIENT_ID",
        "clientSecret": "REDACTED_KRISP_CLIENT_SECRET",
        "scopes": [
          "user::me::read",
          "user::meetings:metadata::read",
          "user::meetings:notes::read",
          "user::meetings:transcripts::read",
          "user::meetings::list",
          "user::activities::list"
        ],
        "pendingAuthorization": {
          "codeVerifier": "REDACTED_CODE_VERIFIER",
          "createdAt": 1772544588502,
          "authorizationUrl": "https://api.krisp.ai/platform/v1/oauth2/authorize?response_type=code&client_id=REDACTED_KRISP_CLIENT_ID&code_challenge=XrZ6V8t752sTH-6xzso0ev6ZK9fIAdJZIEvX-qWF0FA&code_challenge_method=S256&redirect_uri=http%3A%2F%2Flocalhost%3A3000%2Foauth%2Fcallback&state=eyJzZXJ2ZXIiOiJrcmlzcCIsIm5vbmNlIjoiNjFlOWUxM2E2ZmE4NjVlZjBiZjViMDMxZmUwYjliMzMifQ&scope=user%3A%3Ame%3A%3Aread+user%3A%3Ameetings%3Ametadata%3A%3Aread+user%3A%3Ameetings%3Anotes%3A%3Aread+user%3A%3Ameetings%3Atranscripts%3A%3Aread+user%3A%3Ameetings%3A%3Alist+user%3A%3Aactivities%3A%3Alist&resource=https%3A%2F%2Fmcp.krisp.ai%2F",
          "state": "eyJzZXJ2ZXIiOiJrcmlzcCIsIm5vbmNlIjoiNjFlOWUxM2E2ZmE4NjVlZjBiZjViMDMxZmUwYjliMzMifQ"
        }
      }
    }
  },
  "systemConfig": {
    "routing": {
      "enableBearerAuth": false,
      "skipAuth": true
    },
    "oauthServer": {
      "enabled": false,
      "accessTokenLifetime": 3600,
      "refreshTokenLifetime": 1209600,
      "authorizationCodeLifetime": 300,
      "requireClientSecret": false,
      "allowedScopes": [
        "read",
        "write"
      ],
      "requireState": false,
      "dynamicRegistration": {
        "enabled": true,
        "allowedGrantTypes": [
          "authorization_code",
          "refresh_token"
        ],
        "requiresAuthentication": false
      }
    }
  },
